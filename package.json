{
  "name": "team-to-do",
  "version": "1.2.1",
  "description": "Apple Reminders Style Real-time Desktop Team Task & Calendar Widget for Mac & Windows",
  "main": "electron-main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "widget": "electron .",
    "server": "node server.js",
    "app": "electron .",
    "dev": "node server.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.teamtodo.desktopwidget",
    "productName": "Team To do",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "electron-main.js",
      "updater.js",
      "notifier.js",
      "preload.cjs",
      "public/**/*",
      "data/**/*",
      "!data/*.err",
      "!data/*.log",
      "!data/bounds.json",
      "!data/store.json",
      "icon.ico",
      "icon_512.png",
      "icon.png",
      "trayTemplate.png",
      "trayTemplate@2x.png",
      "app.icns",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "yahiabinzaman",
        "repo": "team-to-do"
      }
    ],
    "mac": {
      "icon": "app.icns",
      "identity": null,
      "artifactName": "Team-To-Do-${version}-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true
      },
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Team To do",
      "artifactName": "Team-To-Do-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Team-To-Do-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.11",
    "express": "^4.19.2",
    "nodemailer": "^10.6.1",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^24.13.3"
  },
  "keywords": [
    "apple-widget",
    "macos-widget",
    "windows-widget",
    "reminders",
    "team-tasks",
    "realtime-sync",
    "electron-widget"
  ],
  "author": "Yahia Bin Zaman",
  "license": "MIT"
}
